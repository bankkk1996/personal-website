{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "sorawich.in.th", "custom_domain": true },
    { "pattern": "www.sorawich.in.th", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public"
  }
}
